# Required. Cross runs entirely on NVIDIA Nemotron 3 Super — see
# scripts/lib/aiClient.mjs. Get a key at https://build.nvidia.com.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides — all default sensibly, uncomment to change.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL_OPUS=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODEL_SONNET=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODEL_HAIKU=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODEL_VISION=meta/llama-3.2-11b-vision-instruct

# Optional usage caps for public deployments (see DEPLOY.md).
# DAILY_REQUEST_CAP: total AI requests/day across all visitors (0 = unlimited).
# RATE_LIMIT_PER_MINUTE: per-visitor AI requests/minute.
DAILY_REQUEST_CAP=1000
RATE_LIMIT_PER_MINUTE=20

# --- Auth / sessions (Tabroom gate) ---
# Signs session cookies and keeps sessions valid across restarts. REQUIRED in
# production — the server refuses to boot without it (render.yaml auto-
# generates one). In dev an ephemeral secret is used and every restart logs
# everyone out. Generate one: `openssl rand -hex 32`
SESSION_SECRET=

# Set to "production" on a real deploy so the session cookie is marked Secure
# (HTTPS-only). Leave unset for local http://localhost testing.
# NODE_ENV=production

# OpenCaselist API base. Defaults to the official hosted API; override only to
# point at a different/self-hosted caselist instance. You do NOT need an API
# key — users authenticate with their own Tabroom credentials at login.
# CASELIST_API_BASE=https://api.opencaselist.com/v1

# Per-IP login attempts/minute (brute-force guard on /api/auth/login).
# LOGIN_LIMIT_PER_MINUTE=10

# Failed sign-ins per account within 15 minutes before that account is locked
# out of the login proxy for 15 minutes (per-username brute-force guard).
# LOGIN_LOCKOUT_THRESHOLD=5

# --- Speech-to-text (optional) ---
# Cloud transcription via Groq's hosted whisper-large-v3 (fast, no local
# model download). When unset — or on any Groq failure — falls back to Hume
# EVI (below) for transcript + vocal-tone analysis, then to the fully local
# Whisper pipeline as a last resort.
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3

# Cloud transcription + vocal tone analysis via Hume AI EVI. When set,
# uploaded audio is sent to Hume (leaves the machine) and tone context is fed
# to the model. When unset — or on any Hume failure — transcription falls
# back to the fully local Whisper pipeline (audio stays on-device; no tone
# data).
# HUME_API_KEY=
# Optional: pin a specific EVI config created in the Hume dashboard.
# HUME_CONFIG_ID=

# --- Judge paradigm cache (Supabase) ---
# Optional. Unset = every judge lookup re-scrapes Tabroom and re-runs
# Nemotron every time (no error, just no caching). Service-role key is a
# server-side secret — never commit it, never expose it under web/.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Days before a cached paradigm is re-checked against Tabroom (content-hash
# gated — Nemotron only reruns if the paradigm text actually changed).
# JUDGE_CACHE_MAX_AGE_DAYS=30

# --- Cross accounts (Supabase Auth) ---
# Google / email sign-in. Uses the SAME Supabase project as the judge cache
# above, so SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are required too.
# Apply supabase/migrations/0002_auth.sql before first use.
#
# The anon (publishable) key. Used server-side only, to talk to Supabase's
# GoTrue auth API — the browser never receives it or any Supabase token.
# SUPABASE_ANON_KEY=
#
# Encrypts linked Tabroom/OpenCaselist tokens at rest (AES-256-GCM). Must be
# 64 hex chars. Rotating it invalidates every existing link (users re-link);
# it does NOT affect Cross sign-in. Generate: `openssl rand -hex 32`
# TOKEN_ENC_KEY=
#
# Origin the BROWSER is on — used to build the OAuth/magic-link redirect to
# /api/auth/callback and to send the user back to the app afterwards. In dev
# that's Next's dev server (http://localhost:3001), which proxies /api/* to
# Express; redirecting to Express's own port would land on a 404. Defaults to
# http://localhost:3001 in dev, so it usually only needs setting on a deploy.
# `<PUBLIC_BASE_URL>/api/auth/callback` must also be added to the Supabase
# dashboard under Authentication > URL Configuration > Redirect URLs, or
# sign-in is refused.
# PUBLIC_BASE_URL=https://your-app.onrender.com
#
# Dashboard setup that has no env var here: enable the Google provider
# (Authentication > Providers) with a GCP OAuth client id/secret, and
# configure custom SMTP (Authentication > Emails) — Supabase's built-in
# mailer is capped at a couple of messages per hour and magic links will not
# work reliably without it.
