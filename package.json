{
  "name": "cross-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingestion pipeline for Cross's training-data corpus",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "ingest": "node scripts/ingest.mjs",
    "build-index": "node scripts/build-index.mjs",
    "build-lexical-index": "node scripts/build-lexical-index.mjs",
    "distill": "node --env-file-if-exists=.env scripts/distill.mjs",
    "chat": "node --env-file-if-exists=.env scripts/chat.mjs",
    "web": "NODE_ENV=production node --env-file-if-exists=.env scripts/server.mjs",
    "dev:api": "node --env-file-if-exists=.env scripts/server.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --env-file-if-exists=.env scripts/server.mjs\" \"npm:dev:web\""
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "@xmldom/xmldom": "^0.8.13",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "html-to-text": "^9.0.5",
    "hume": "^0.16.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "openai": "^6.47.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.19.1",
    "wavefile": "^11.0.0"
  }
}
