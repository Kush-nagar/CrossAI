node_modules/
.DS_Store
# Cheap to build (~30s, no embedding model, no network) — unlike
# corpus-index.json, so it's rebuilt at deploy/dev time instead of
# committed. At current corpus size this file runs 300MB+, well over
# GitHub's 100MB per-file limit, so committing it isn't an option anyway.
scripts/lexical-index.json
incoming/processed/*
!incoming/processed/.gitkeep
generated/*
!generated/.gitkeep
uploads/*
!uploads/.gitkeep
case-uploads/*
!case-uploads/.gitkeep
voice-profile.json
feedback.json
.env
delivery-history.json
distill-data/
delivery-data/*
!delivery-data/README.md
